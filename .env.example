# Skopiuj ten plik jako .env.local (obok package.json) i uzupełnij wartości.
# Pliku .env.local nie wysyłasz nikomu i nie wrzucasz na GitHub.

# Klucz z prywatnej wiadomości od LABA
OPENROUTER_API_KEY=

# Model do rozmowy (Gemini obsługuje wyszukiwanie Google i zdjęcia)
OPENROUTER_MODEL=google/gemini-3.8-flash

# Lekcja 5 — baza Supabase (te same wartości co na lekcji 5)
# Adres projektu: Supabase → Connect → Project URL, np. https://abcdefgh.supabase.co
SUPABASE_URL=
# Klucz secret: Supabase → Settings → API Keys, zaczyna się od sb_secret_
# Używa go tylko serwer. Nigdy nie dodawaj do nazwy przedrostka NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Lekcja 6 — model embeddingów (uzupełnisz na zajęciach)
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Lekcja 7 — logowanie (Supabase Auth)
# Adres: ten sam co SUPABASE_URL. Klucz: Supabase → Settings → API Keys, zaczyna się od sb_publishable_
# Ten klucz jest publiczny (trafia do przeglądarki); danych pilnują reguły RLS w bazie.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
